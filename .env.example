# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<use-strong-password>
POSTGRES_DB=kino_tracker
POSTGRES_DB_CONNECTION_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Telegram Bot
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>

# OpenAI API
OPENAI_API_KEY=<your-openai-api-key>

# ElevenLabs API
ELEVEN_API_KEY=<your-elevenlabs-api-key>
# Optional: voice ID (UUID from ElevenLabs "My Voices" → Copy voice ID). If unset, default voice is used.
# ELEVEN_VOICE_ID=

# Optional: Azure Application Insights (for logging)
# APPINSIGHTS_INSTRUMENTATIONKEY=<your-app-insights-key>

# Optional: Sentry for error tracking
# SENTRY_DSN=<your-sentry-dsn>

# Optional: Miner cinema API (iframe.cineorder.filmpalast.net). If the API returns 403 (Cloudflare),
# copy from browser DevTools: cineorder-user header (JWT, with or without "bearer ") and Cookie (e.g. __cfwaitingroom).
# CINEORDER_USER=<jwt-from-cineorder-user-header>
# CINEORDER_COOKIE=__cfwaitingroom=...
